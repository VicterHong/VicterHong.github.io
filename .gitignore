# Berkas rahasia layanan token — tidak pernah masuk repo publik.
backend/service.env
backend/.env
*.db
*.db-wal
*.db-shm
node_modules/
backend/src/config.mjs
backend/.env
backend/node_modules/
.env

# Hasil build (CSS terminifikasi) — dihasilkan ulang oleh build-css.mjs
dist/

# Alat pengembang — pratinjau email (dibangun oleh scripts/preview-email.mjs)
preview-email/
preview-email.html
.email-domain/

# HTML ekspor dari platform visual (besar, bisa diekspor ulang)
email-src/impor/*.html

# Hasil build halaman /akses/ — dibuat ulang oleh scripts/build-akses.mjs.
# Yang di-commit hanya sumbernya (akses/app/*.tsx, akses/app/app.css), supaya
# riwayat repo tidak menyimpan bundle yang bisa diregenerasi.
akses/assets/app.js
akses/assets/app.css
akses/assets/fonts/
