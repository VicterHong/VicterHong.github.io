/**
 * Uji UI enrollment 2FA di browser sungguhan.
 *
 * Menjalankan server backend uji + serve statis, lalu menjalankan
 * Playwright untuk memeriksa alur: login → tawaran 2FA → QR → verifikasi
 * → kode pemulihan → konfirmasi.
 */
import pw from '/home/ubuntu/.npm/_npx/e41f203b7505f1fb/node_modules/playwright/index.js';
const { chromium } = pw;

import { spawn, execFileSync } from 'node:child_process';
import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';

const DIR = mkdtempSync(join(tmpdir(), 'uji-ui-'));
// ── Port ACAK, bukan tetap ────────────────────────────────────────────────
//
// Port tetap (8801/8802) berulang kali bentrok dengan server uji yang
// tertinggal — dan gejalanya membingungkan: uji bicara dengan server LAMA
// dan mendapat error yang tidak ada hubungannya dengan kode yang diuji.
//
// Port acak di rentang tinggi menghilangkan seluruh kelas masalah itu.
// Tidak perlu pembersihan port, tidak perlu khawatir sisa proses.
const BE_PORT = 41000 + Math.floor(Math.random() * 5000);
const FE_PORT = BE_PORT + 1;
const BE = `http://127.0.0.1:${BE_PORT}`;

let lulus = 0, gagal = 0;
const cek = (nama, hasil, harapan) => {
  const ok = hasil === harapan;
  if (ok) { lulus++; console.log(`  ✅ ${nama}`); }
  else { gagal++; console.log(`  ❌ ${nama}\n     dapat: ${JSON.stringify(hasil)}\n     harus: ${JSON.stringify(harapan)}`); }
};

// ── Siapkan server backend uji ─────────────────────────────────────────────
const ENV_KOSONG = join(DIR, 'kosong.env');
writeFileSync(ENV_KOSONG, '# uji\n');

const envBe = {
  ...process.env,
  DB_PATH: join(DIR, 'uji.db'),
  PORT: String(BE_PORT),
  HOST: '127.0.0.1',
  TOKEN_SERVICE_ENV: ENV_KOSONG,
  SERVICE_SECRET: 'uji-service-secret-panjang-minimal-24-karakter-abcdef',
  ADMIN_KEY: 'uji-admin-key-panjang-minimal-24-karakter-xyz',
  SALES_EMAIL: 'uji@example.com',
  TURNSTILE_SITE_KEY: '1x00000000000000000000AA',
  TURNSTILE_SECRET_KEY: '1x0000000000000000000000000000000AA',
  TURNSTILE_HOSTNAMES: 'example.com',
  NODE_ENV: 'test',
};

// ── Bersihkan server uji yang tertinggal ───────────────────────────────────
//
// Uji sebelumnya mungkin tidak mati bersih (SIGTERM diabaikan, atau proses
// anak). Kalau port sudah dipakai, server BARU gagal bind — tapi uji tetap
// bicara dengan server LAMA dan mendapat error yang membingungkan
// (token_invalid, 503, dst) padahal konfigurasinya sama sekali berbeda.
//
// Ini sudah terjadi beberapa kali. Jadi bersihkan SEMUA server uji dulu.
{
  const { readdirSync, readFileSync } = await import('node:fs');
  let dibunuh = 0;
  for (const entri of readdirSync('/proc')) {
    if (!/^\d+$/.test(entri)) continue;
    const pid = Number(entri);
    // JANGAN bunuh diri sendiri atau induk — kalau tidak, uji mati di tengah.
    if (pid === process.pid || pid === process.ppid) continue;
    try {
      const cmd = readFileSync(`/proc/${entri}/cmdline`, 'utf8').replace(/\0/g, ' ').trim();
      // Harus benar-benar menjalankan server.mjs — bukan sekadar menyebut
      // nama file itu di argumen lain (mis. skrip uji ini sendiri).
      // Kenali SEMUA server uji yang mungkin tertinggal:
      //   node src/server.mjs        → backend uji
      //   node serve-uji.mjs 88xx    → server statis uji
      //   python -m http.server 88xx → versi lama (masih mungkin tertinggal)
      const serverUji = /^(\S*\/)?node\s+src\/server\.mjs\s*$/.test(cmd);
      const statisUji = /^(\S*\/)?node\s+serve-uji\.mjs\s+88\d\d/.test(cmd);
      const httpUji = /^python3?\s+-m\s+http\.server\s+88\d\d/.test(cmd);
      if (serverUji || statisUji || httpUji) {
        process.kill(pid, 'SIGKILL');
        dibunuh++;
      }
    } catch { /* proses hilang — abaikan */ }
  }
  if (dibunuh) console.log(`  (${dibunuh} server uji lama dibersihkan)`);
  await new Promise((r) => setTimeout(r, 800));
}

// Cek port bebas
for (const p of [BE_PORT, FE_PORT]) {
  const { createServer } = await import('node:net');
  const bebas = await new Promise((r) => {
    const t = createServer();
    t.once('error', () => r(false));
    t.once('listening', () => t.close(() => r(true)));
    t.listen(p, '127.0.0.1');
  });
  if (!bebas) { console.log(`  ❌ port ${p} dipakai proses lain`); process.exit(1); }
}

const be = spawn('node', ['src/server.mjs'], {
  cwd: '/home/ubuntu/portfolio-victer/backend', env: envBe, stdio: ['ignore', 'pipe', 'pipe'],
});
let beLog = '';
be.stdout.on('data', (d) => { beLog += d; });
be.stderr.on('data', (d) => { beLog += d; });

// Serve frontend (dist/) — tapi kita perlu proxy /api ke backend uji.
// Paling sederhana: serve dist/ dan arahkan fetch /api langsung ke BE_PORT
// lewat route interception di Playwright.
// Pakai server Node sendiri, bukan python http.server.
// Alasan: python http.server yang tertinggal dari uji sebelumnya akan
// menyajikan build LAMA tanpa peringatan — hasil uji jadi menyesatkan.
// serve-uji.mjs gagal cepat dengan pesan jelas kalau port sudah dipakai.
const fe = spawn('node', ['serve-uji.mjs', String(FE_PORT), '/home/ubuntu/portfolio-victer/dist'], {
  cwd: '/home/ubuntu/portfolio-victer/backend', stdio: ['ignore', 'pipe', 'pipe'],
});
let feLog = '';
fe.stdout.on('data', (d) => { feLog += d; });
fe.stderr.on('data', (d) => { feLog += d; });

// Tunggu keduanya siap
let beSiap = false, feSiap = false;
for (let i = 0; i < 60; i++) {
  await new Promise((r) => setTimeout(r, 250));
  if (!beSiap) {
    try {
      const h = await fetch(`${BE}/api/health`, { signal: AbortSignal.timeout(1500) });
      beSiap = h.ok;
    } catch {}
  }
  if (!feSiap) {
    try {
      const f = await fetch(`http://127.0.0.1:${FE_PORT}/masuk.html`, { signal: AbortSignal.timeout(1500) });
      // Pastikan yang menyajikan adalah build TERBARU — bukan server lama
      // dengan berkas lama. Cek penanda yang hanya ada di versi baru.
      if (f.ok) {
        const teks = await f.text();
        feSiap = teks.includes('panel-setup2fa');
      }
    } catch {}
  }
  if (beSiap && feSiap) break;
}

if (!beSiap) { console.log('  ❌ backend tidak siap'); console.log(beLog.slice(-600)); }
if (!feSiap) { console.log('  ❌ frontend tidak siap / build LAMA'); console.log(feLog.slice(-400)); }
if (!beSiap || !feSiap) {
  be.kill('SIGKILL'); fe.kill('SIGKILL');
  rmSync(DIR, { recursive: true, force: true });
  process.exit(1);
}

console.log('══ SERVER UJI SIAP ══');
console.log(`  backend : ${BE}`);
console.log(`  frontend: http://127.0.0.1:${FE_PORT}`);
console.log();

// ── Buat token klien ───────────────────────────────────────────────────────
let tokenPlain = null;
try {
  const out = execFileSync('node', [
    'src/admin-cli.mjs', 'issue',
    '--project', 'mina', '--tier', 'standard',
    '--to', 'klien-ui@perusahaan.co.id', '--label', 'Uji UI 2FA',
  ], { cwd: '/home/ubuntu/portfolio-victer/backend', env: envBe, encoding: 'utf8', timeout: 15000 });
  tokenPlain = out.match(/(VP-[A-Z0-9-]+)/)?.[1] ?? null;
} catch (e) { console.log('  ⚠ CLI gagal:', e.message.slice(0, 150)); }

if (!tokenPlain) {
  console.log('  ❌ token tidak dibuat');
  be.kill('SIGKILL'); fe.kill('SIGKILL');
  rmSync(DIR, { recursive: true, force: true });
  process.exit(1);
}
console.log(`══ TOKEN DIBUAT ══\n  ${tokenPlain.slice(0, 22)}…\n`);

// ── Playwright ─────────────────────────────────────────────────────────────
const browser = await chromium.launch({ args: ['--no-sandbox'] });
const page = await browser.newPage({ viewport: { width: 1280, height: 940 } });

const errors = [];
page.on('console', (m) => { if (m.type() === 'error') errors.push(m.text()); });
page.on('pageerror', (e) => errors.push(`PAGEERROR: ${e.message}`));

// Arahkan /api/* ke backend uji
// Teruskan cookie clearance (dan cookie sesi nanti) ke backend.
// Kita kelola cookie secara manual karena cookie `__Host-` tidak bisa
// disetel di halaman HTTP.
let cookieTambahan = '';

await page.route('**/api/**', async (route) => {
  const req = route.request();
  const url = new URL(req.url());
  const target = `${BE}${url.pathname}${url.search}`;

  // ── KENAPA FETCH NODE, BUKAN route.fetch() ────────────────────────────────
  // Playwright mengelola header `cookie` sendiri — header yang kita set
  // eksplisit TIDAK selalu diteruskan (terbukti: cookie gate hilang, dan
  // backend menjawab `token_kosong`). Dengan fetch Node, kita kontrol penuh
  // atas seluruh header.
  const cookieBrowser = req.headers()['cookie'] ?? '';
  const cookieHeader = [cookieBrowser, cookieTambahan].filter(Boolean).join('; ');

  const headers = { 'content-type': 'application/json' };
  if (cookieHeader) headers.cookie = cookieHeader;
  if (req.headers()['user-agent']) headers['user-agent'] = req.headers()['user-agent'];

  let body;
  try { body = req.postData(); } catch { body = undefined; }

  const res = await fetch(target, {
    method: req.method(),
    headers,
    body: req.method() === 'GET' || req.method() === 'HEAD' ? undefined : body,
  });

  const teks = await res.text();
  const resHeaders = {};
  for (const [k, v] of res.headers) resHeaders[k] = v;

  // Tangkap Set-Cookie supaya bisa diteruskan di request berikutnya
  // (cookie sesi setelah login).
  const setC = res.headers.getSetCookie?.() ?? [];
  for (const baris of setC) {
    const pasangan = baris.split(';')[0];
    const nama = pasangan.split('=')[0];
    const daftar = cookieTambahan.split('; ').filter(Boolean)
      .filter((c) => !c.startsWith(`${nama}=`));
    daftar.push(pasangan);
    cookieTambahan = daftar.join('; ');
  }

  await route.fulfill({ status: res.status, headers: resHeaders, body: teks });
});

// Log semua request/response /api — supaya kegagalan login terlihat
// apa adanya (status, pesan server), bukan cuma gejalanya.
page.on('response', async (r) => {
  if (r.url().includes('/api/')) {
    let isi = '';
    try { isi = (await r.text()).slice(0, 180); } catch {}
    console.log(`     [jaringan] ${r.status()} ${new URL(r.url()).pathname} → ${isi}`);
  }
});
page.on('pageerror', (e) => console.log('     [PAGEERROR]', e.message.slice(0, 200)));

await page.goto(`http://127.0.0.1:${FE_PORT}/masuk.html`, { waitUntil: 'networkidle' });
await page.waitForTimeout(800);

console.log('══ 1. PANEL SETUP 2FA ADA DI DOM ══');
cek('panel setup2fa ada', await page.locator('#panel-setup2fa').count(), 1);
cek('panel pemulihan ada', await page.locator('#panel-pemulihan').count(), 1);
cek('elemen QR ada', await page.locator('#qrImage').count(), 1);
cek('skeleton QR ada', await page.locator('#qrSkeleton').count(), 1);
cek('6 sel OTP setup', await page.locator('[data-otp-setup]').count(), 6);
cek('tombol tawaran 2FA ada', await page.locator('#btnSetup2faMulai').count(), 1);
cek('checkbox konfirmasi ada', await page.locator('#chkSimpan').count(), 1);
cek('tombol lanjut ada', await page.locator('#btnLanjut').count(), 1);
console.log();

console.log('══ 2. LOLOS GATE VERIFIKASI (seperti pengunjung sungguhan) ══');
//
// Ada DUA gerbang sebelum bisa login:
//   1. Gate verifikasi pengunjung (Turnstile) — menghasilkan cookie clearance
//   2. Token akses
//
// Uji ini harus melewati gerbang pertama dulu. Caranya sama seperti
// pengunjung: kirim token Turnstile ke /api/verify-turnstile, lalu simpan
// cookie yang dikembalikan.
//
// Kunci testing Cloudflare membuat langkah ini deterministik — tidak perlu
// iframe widget yang tidak tersedia di lingkungan uji.
{
  const verif = await fetch(`${BE}/api/verify-turnstile`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Origin: `http://127.0.0.1:${FE_PORT}` },
    // Nama field HARUS `token` — itu yang dibaca endpoint (lihat routes.mjs).
    // cf-gate.js juga mengirim { token }, bukan { cf-turnstile-response }.
    body: JSON.stringify({ token: 'XXXX.DUMMY.TOKEN.XXXX' }),
  });
  const isi = await verif.json().catch(() => ({}));
  const setCookie = verif.headers.get('set-cookie') ?? '';

  if (verif.status !== 200) {
    console.log('     detail:', JSON.stringify(isi));
  }
  cek('verifikasi gate berhasil', verif.status, 200);
  cek('cookie clearance diterbitkan', setCookie.includes('__Host-'), true);
  console.log(`     status ${verif.status} · cookie: ${setCookie.slice(0, 44)}…`);

  // ── Teruskan cookie clearance ke setiap request /api/* ──────────────────
  //
  // Cookie ini bernama `__Host-portfolio_gate` — prefix `__Host-` WAJIB
  // Secure + path=/ + tanpa Domain menurut spesifikasi cookie. Playwright
  // MENOLAK menyetel cookie seperti itu di halaman HTTP (dan itu benar:
  // browser sungguhan juga akan menolaknya).
  //
  // Jadi kita tidak menyetel cookie di browser. Kita TERUSKAN header Cookie
  // secara manual di setiap request /api/* lewat route interception.
  // Efeknya identik: backend melihat request dengan cookie clearance yang sah.
  const cookieGate = setCookie.split(';')[0];   // "nama=nilai"
  cookieTambahan = cookieGate;   // dipakai oleh route interception di atas
  console.log(`     cookie diteruskan lewat header: ${cookieGate.slice(0, 30)}…`);
}
console.log();

console.log('══ 3. LOGIN → PANEL SELESAI + TAWARAN 2FA ══');
await page.selectOption('#inpProject', 'mina');
await page.fill('#inpToken', tokenPlain);
await page.click('#btnSubmit');
await page.waitForTimeout(2000);

const panelSetelahLogin = await page.evaluate(() =>
  document.querySelector('.auth-panel.is-active')?.dataset.panel);
cek('pindah ke panel selesai', panelSetelahLogin, 'done');
cek('tombol setup 2FA terlihat', await page.locator('#btnSetup2faMulai').isVisible(), true);
console.log();

console.log('══ 4. KLIK SETUP 2FA → QR MUNCUL ══');
await page.click('#btnSetup2faMulai');
await page.waitForTimeout(2500);

const panelSetup = await page.evaluate(() =>
  document.querySelector('.auth-panel.is-active')?.dataset.panel);
cek('pindah ke panel setup2fa', panelSetup, 'setup2fa');

const qrInfo = await page.evaluate(() => {
  const img = document.querySelector('#qrImage');
  const sk = document.querySelector('#qrSkeleton');
  return {
    qrTerlihat: img ? !img.hidden : false,
    qrAdaSrc: img ? String(img.src).startsWith('data:image/png;base64,') : false,
    qrPanjang: img ? img.src.length : 0,
    qrNaturalW: img ? img.naturalWidth : 0,
    skeletonTersembunyi: sk ? sk.hidden : false,
    qrLebarCSS: img ? Math.round(img.getBoundingClientRect().width) : 0,
  };
});
cek('QR terlihat', qrInfo.qrTerlihat, true);
cek('QR pakai data URL PNG', qrInfo.qrAdaSrc, true);
cek('QR benar-benar termuat (naturalWidth > 0)', qrInfo.qrNaturalW > 0, true);
cek('skeleton disembunyikan', qrInfo.skeletonTersembunyi, true);
cek('QR ukuran wajar (~200px)', qrInfo.qrLebarCSS >= 150 && qrInfo.qrLebarCSS <= 260, true);
console.log(`     detail: ${qrInfo.qrNaturalW}px natural · ${qrInfo.qrPanjang} char data URL · ${qrInfo.qrLebarCSS}px CSS`);
console.log();

console.log('══ 5. SECRET MANUAL TERSEDIA ══');
const secret = await page.textContent('#secretText');
cek('secret terisi', typeof secret === 'string' && secret.length === 32, true);
cek('secret hanya karakter base32', /^[A-Z2-7]{32}$/.test(secret ?? ''), true);
cek('detail secret ada (fallback)', await page.locator('#secretDetail').count(), 1);
console.log();

console.log('══ 6. VERIFIKASI KODE SALAH ══');
const selSetup = page.locator('[data-otp-setup]');
await selSetup.first().focus();
await page.keyboard.type('000000', { delay: 30 });
await page.waitForTimeout(1500);

const msgSalah = await page.textContent('#msgSetup2fa');
cek('pesan galat muncul', typeof msgSalah === 'string' && msgSalah.length > 0, true);
cek('kelas galat aktif', await page.evaluate(() =>
  document.querySelector('#msgSetup2fa')?.classList.contains('is-galat')), true);
cek('sel dikosongkan setelah gagal', await page.evaluate(() =>
  Array.from(document.querySelectorAll('[data-otp-setup]')).map((s) => s.value).join('')), '');
cek('masih di panel setup', await page.evaluate(() =>
  document.querySelector('.auth-panel.is-active')?.dataset.panel), 'setup2fa');
console.log();

console.log('══ 7. VERIFIKASI KODE BENAR → KODE PEMULIHAN ══');
// Hitung kode TOTP dari secret yang ditampilkan
const { buatTotp } = await import('/home/ubuntu/portfolio-victer/backend/src/totp.mjs');
const kodeBenar = buatTotp(secret);

await selSetup.first().focus();
await page.keyboard.type(kodeBenar, { delay: 30 });
await page.waitForTimeout(2500);

const panelPemulihan = await page.evaluate(() =>
  document.querySelector('.auth-panel.is-active')?.dataset.panel);
cek('pindah ke panel pemulihan', panelPemulihan, 'pemulihan');

const kodeList = await page.evaluate(() =>
  Array.from(document.querySelectorAll('#recoveryList li')).map((li) => li.textContent));
cek('8 kode pemulihan ditampilkan', kodeList.length, 8);
cek('format kode XXXXX-XXXXX', /^[A-Z2-7]{5}-[A-Z2-7]{5}$/.test(kodeList[0] ?? ''), true);
cek('semua kode unik', new Set(kodeList).size, 8);
console.log(`     contoh: ${kodeList.slice(0, 3).join('  ')}`);
console.log();

console.log('══ 8. KONFIRMASI WAJIB ══');
cek('tombol lanjut DISABLED sebelum dicentang',
  await page.locator('#btnLanjut').isDisabled(), true);
cek('checkbox belum dicentang', await page.locator('#chkSimpan').isChecked(), false);

await page.check('#chkSimpan');
await page.waitForTimeout(300);
cek('tombol lanjut AKTIF setelah dicentang',
  await page.locator('#btnLanjut').isDisabled(), false);
console.log();

console.log('══ 9. TOMBOL SALIN & UNDUH ADA ══');
cek('tombol salin semua ada', await page.locator('#btnCopyRecovery').count(), 1);
cek('tombol unduh ada', await page.locator('#btnUnduhRecovery').count(), 1);

// Uji unduh benar-benar menghasilkan berkas
const unduhan = await Promise.all([
  page.waitForEvent('download', { timeout: 8000 }).catch(() => null),
  page.click('#btnUnduhRecovery'),
]);
const dl = unduhan[0];
cek('unduhan terpicu', dl !== null, true);
if (dl) {
  cek('nama berkas .txt', dl.suggestedFilename().endsWith('.txt'), true);
  const jalur = join(DIR, 'unduhan.txt');
  await dl.saveAs(jalur);
  const isi = (await import('node:fs')).readFileSync(jalur, 'utf8');
  cek('berkas berisi 8 kode', (isi.match(/[A-Z2-7]{5}-[A-Z2-7]{5}/g) ?? []).length, 8);
  cek('berkas berisi peringatan', isi.includes('JANGAN bagikan'), true);
}
console.log();

console.log('══ 10. RESPONSIF ══');
const pageMobile = await browser.newPage({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 2 });
await pageMobile.route('**/api/**', async (route) => {
  const url = new URL(route.request().url());
  await route.fulfill({ response: await route.fetch({ url: `${BE}${url.pathname}${url.search}` }) });
});
await pageMobile.goto(`http://127.0.0.1:${FE_PORT}/masuk.html`, { waitUntil: 'networkidle' });
await pageMobile.waitForTimeout(600);

// Paksa tampilkan panel setup untuk mengukur QR di layar sempit
await pageMobile.evaluate(() => {
  document.querySelectorAll('.auth-panel').forEach((p) =>
    p.classList.toggle('is-active', p.dataset.panel === 'setup2fa'));
});
await pageMobile.waitForTimeout(400);

const qrMobile = await pageMobile.evaluate(() => {
  const img = document.querySelector('#qrImage');
  const wrap = document.querySelector('#qrWrap');
  const r = img?.getBoundingClientRect();
  return {
    lebar: r ? Math.round(r.width) : 0,
    meluber: wrap ? wrap.scrollWidth > wrap.clientWidth + 2 : false,
  };
});
cek('QR muat di layar 390px', qrMobile.lebar > 0 && qrMobile.lebar <= 200, true);
cek('tidak ada elemen meluber', qrMobile.meluber, false);
console.log(`     QR di mobile: ${qrMobile.lebar}px`);
console.log();

console.log('══ 11. REDUCED MOTION ══');
const pageRM = await browser.newPage({
  viewport: { width: 1280, height: 940 }, reducedMotion: 'reduce',
});
await pageRM.route('**/api/**', async (route) => {
  const url = new URL(route.request().url());
  await route.fulfill({ response: await route.fetch({ url: `${BE}${url.pathname}${url.search}` }) });
});
await pageRM.goto(`http://127.0.0.1:${FE_PORT}/masuk.html`, { waitUntil: 'networkidle' });
await pageRM.waitForTimeout(500);

const rm = await pageRM.evaluate(() => {
  const sk = document.querySelector('.auth-qr-shimmer');
  const li = document.querySelector('#recoveryList li');
  return {
    shimmerAnimasi: sk ? getComputedStyle(sk).animationName : 'tidak ada',
    liAnimasi: li ? getComputedStyle(li).animationName : '(belum ada li)',
  };
});
cek('shimmer QR dimatikan', rm.shimmerAnimasi === 'none', true);
console.log();

console.log('══ 12. KONSOL BERSIH ══');
const errAsli = errors.filter((e) =>
  !/Failed to load resource.*(401|403|404|501)/.test(e) &&
  !/favicon/.test(e));
cek('tidak ada error JS', errAsli.length, 0);
if (errAsli.length) errAsli.slice(0, 5).forEach((e) => console.log('     ❌', e.slice(0, 120)));
console.log();

// ── Screenshot ─────────────────────────────────────────────────────────────
await page.evaluate(() => {
  document.querySelectorAll('.auth-panel').forEach((p) =>
    p.classList.toggle('is-active', p.dataset.panel === 'pemulihan'));
});
await page.waitForTimeout(500);
await page.screenshot({ path: '/tmp/2fa-pemulihan.png' });

await page.evaluate(() => {
  document.querySelectorAll('.auth-panel').forEach((p) =>
    p.classList.toggle('is-active', p.dataset.panel === 'setup2fa'));
});
await page.waitForTimeout(500);
await page.screenshot({ path: '/tmp/2fa-setup.png' });

// ── Bersihkan ──────────────────────────────────────────────────────────────
await browser.close();
be.kill('SIGKILL');
fe.kill('SIGKILL');
await new Promise((r) => setTimeout(r, 600));
rmSync(DIR, { recursive: true, force: true });

console.log('═'.repeat(62));
console.log(`  LULUS: ${lulus}   GAGAL: ${gagal}`);
console.log('═'.repeat(62));
if (gagal === 0) {
  console.log('\n  ✅ UI enrollment 2FA bekerja lengkap.');
  console.log('     Screenshot: /tmp/2fa-setup.png, /tmp/2fa-pemulihan.png');
} else {
  console.log('\n  ⚠ Ada yang gagal.');
  if (beLog) console.log('\n  log backend (ekor):\n', beLog.slice(-1200));
  process.exit(1);
}
