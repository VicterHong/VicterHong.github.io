{
  "name": "portfolio-victer",
  "version": "3.0.0",
  "description": "Victer Portfolio — Token-gated B2B project showcase on Cloudflare Edge",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/generate-discovery.mjs && wrangler pages deploy . --project-name=portfolio-victer",
    "discovery": "node scripts/generate-discovery.mjs",
    "preflight": "node scripts/preflight.mjs",
    "debug": "node scripts/debug-production.mjs",
    "debug:network": "node scripts/debug-network.mjs",
    "shot": "node scripts/shot.mjs",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "cf:dev": "cf dev",
    "cf:build": "cf build",
    "cf:deploy": "cf deploy",
    "r2:upload": "wrangler r2 object put portfolio-assets/ --file=",
    "r2:list": "wrangler r2 object list portfolio-assets",
    "logs": "wrangler tail",
    "status": "curl -s https://portfolio-victer.victerphanjaya.workers.dev/health | python3 -m json.tool"
  },
  "dependencies": {
    "cloudflare": "^1.0.0-beta.12"
  },
  "devDependencies": {
    "wrangler": "^4.147.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["portfolio", "cloudflare", "workers", "b2b", "token-gated", "cms", "seo", "aeo"],
  "author": "Victer",
  "license": "MIT"
}
