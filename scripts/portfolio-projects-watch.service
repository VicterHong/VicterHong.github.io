[Unit]
Description=Portofolio: terbitkan projects/<nama>/ otomatis (build, preflight, deploy)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/portfolio-victer
ExecStart=/home/ubuntu/.hermes/node/bin/node scripts/watch-projects.mjs
Environment=JEDA_MS=20000
Environment=PROJECTS_DEPLOY=true
Environment=PROJECTS_PUSH=true
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
